# Backend
PORT=8080
FRONTEND_URL=http://localhost:5173

# Frontend: Vite exposes variables prefixed with VITE_ to the browser.
# Never put secrets in VITE_ variables.
VITE_API_URL=http://localhost:8080/api

# PostgreSQL: separate fields avoid URL-encoding special password characters.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notes_app
DB_USER=notes_user
# Enter the notes_user password locally, inside double quotes.
DB_PASSWORD=""

# Optional: host port for PostgreSQL in Docker (local PostgreSQL can stay on 5432).
DOCKER_DB_PORT=5433

# Optional: published port for the backend container.
DOCKER_API_PORT=8080

# Optional: browser port for the compiled frontend served by Nginx.
DOCKER_WEB_PORT=3000
